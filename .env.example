# Local Spotify OAuth
DEMO_MODE=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
# Generate a base64-encoded 32-byte key for local token encryption.
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# Optional: set to the full public origin when deploying on a custom domain.
NEXT_PUBLIC_SITE_URL=
